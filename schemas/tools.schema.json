{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Tool radar configuration",
  "type": "object",
  "required": ["tools"],
  "properties": {
    "preferences": {
      "type": "object",
      "properties": {
        "interests": { "type": "array", "items": { "type": "string" } },
        "summaryStyle": { "type": "string" },
        "english": { "type": "string" },
        "maxHighlightsPerTool": { "type": "integer", "minimum": 1, "maximum": 10 }
      }
    },
    "tools": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "website", "repository"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "name": { "type": "string" },
          "website": { "type": "string", "format": "uri" },
          "repository": { "type": ["string", "null"], "pattern": "^[\\w.-]+/[\\w.-]+$" },
          "why": { "type": "string" },
          "interests": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    }
  }
}
