# Absolute path to the private tool-radar-data checkout (pipeline input/output).
TOOL_RADAR_DATA_REPO=/absolute/path/to/tool-radar-data

# Coding agent used for release summaries (optional).
RADAR_AGENT=opencode
RADAR_MODEL=
OPENCODE_API_KEY=

# GitHub token for the deterministic release fetch (avoids API rate limits).
GITHUB_TOKEN=
